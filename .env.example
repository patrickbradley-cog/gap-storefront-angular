# Copy to .env (git-ignored) and set your own passwords; never commit .env.
# docker compose reads .env automatically. Load it into your shell for the API
# and seed script with:  set -a; . ./.env; set +a

# Oracle XE SYS/SYSTEM password (container admin only; the app never uses it).
ORACLE_SYS_PASSWORD=
# Password of the GAPCAT app user — used by compose, seed:oracle and the API.
ORACLE_PASSWORD=
# Postgres superuser (gapcat) password.
POSTGRES_PASSWORD=
