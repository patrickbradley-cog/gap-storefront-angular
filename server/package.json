{
  "name": "gap-storefront-api",
  "version": "0.0.0",
  "private": true,
  "description": "Mock catalog/bag/checkout API for the gap-storefront demo",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "seed:oracle": "tsx scripts/seed-oracle.ts"
  },
  "dependencies": {
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "oracledb": "7.0.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "18.19.68",
    "@types/oracledb": "7.0.3",
    "tsx": "4.19.2",
    "typescript": "4.9.5"
  }
}
